# .env — environment configuration for the racing system.
# Copy to .env and fill in real values. NEVER commit the real .env.
# get_config() (src/config.py) raises KeyError if a MANDATORY key is missing.

# ---------------------------------------------------------------------------
# Racing API Pro — MANDATORY (Basic Auth: username + password, NOT an api key)
# ---------------------------------------------------------------------------
RACING_API_USERNAME=
RACING_API_PASSWORD=
RACING_API_BASE=https://api.theracingapi.com/v1

# ---------------------------------------------------------------------------
# MySQL database — MANDATORY
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---------------------------------------------------------------------------
# Email / SMTP — MANDATORY (Gmail: EMAIL_PASSWORD must be an App Password)
# ---------------------------------------------------------------------------
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---------------------------------------------------------------------------
# Project meta — OPTIONAL (sensible defaults)
# ---------------------------------------------------------------------------
PROJECT_DIR=
MODEL_VERSION=v3
REGIONS=gb,ire

# ---------------------------------------------------------------------------
# AI Form Reader (Anthropic) — OPTIONAL. If absent the AI layer degrades
# gracefully and the pipeline is unaffected.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Reliability heartbeat (dead-man's switch) — OPTIONAL but recommended.
# Create a check at https://healthchecks.io (free), paste its ping URL here.
# Each pipeline pings on SUCCESS; if the ping is missed, healthchecks emails you.
# Leave blank to disable (the ping becomes a no-op). See RELIABILITY.md.
# ---------------------------------------------------------------------------
HEARTBEAT_URL_MORNING=
HEARTBEAT_URL_EVENING=
