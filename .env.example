# ============================================================
# Racing Edge — environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Racing API Pro (Basic Auth)
RACING_API_USERNAME=your_racing_api_username_here
RACING_API_PASSWORD=your_racing_api_password_here
RACING_API_BASE=https://api.theracingapi.com/v1

# MySQL Database (PythonAnywhere)
DB_HOST=your_pythonanywhere_username.mysql.pythonanywhere-services.com
DB_PORT=3306
DB_NAME=your_pythonanywhere_username$racing_model
DB_USER=your_pythonanywhere_username
DB_PASS=your_database_password

# Email (SMTP)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Project
PROJECT_DIR=/home/v5racing/racing_model
MODEL_VERSION=v3
REGIONS=gb,ire
